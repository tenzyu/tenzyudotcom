{
  "name": "@tenzyu/osu-skin-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:browser-boundary": "bash -lc \"! grep -RInE 'from [\\\"'\\'' ]node:|import .*node:' src\"",
    "check": "bun run typecheck && bun run test && bun run check:browser-boundary"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.7.2"
  }
}
