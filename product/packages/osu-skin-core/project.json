{
  "name": "osu-skin-core",
  "projectType": "library",
  "root": "product/packages/osu-skin-core",
  "sourceRoot": "product/packages/osu-skin-core/src",
  "tags": [
    "scope:osu-skin",
    "type:library",
    "runtime:pure"
  ],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {},
    "test": {},
    "package-smoke": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "test",
        "browser-boundary",
        "package-smoke"
      ],
      "cache": false
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "check"
      ],
      "cache": false
    },
    "browser-boundary": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run check:browser-boundary"
      },
      "cache": false
    }
  }
}
