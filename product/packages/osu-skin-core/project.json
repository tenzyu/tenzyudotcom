{
  "name": "osu-skin-core",
  "projectType": "library",
  "root": "product/packages/osu-skin-core",
  "sourceRoot": "product/packages/osu-skin-core/src",
  "tags": [
    "scope:osu-skin",
    "type:library"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run test"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run typecheck && bun run test"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run typecheck"
      }
    }
  }
}
