{
  "name": "osu-skin-core",
  "projectType": "library",
  "root": "product/packages/osu-skin-core",
  "sourceRoot": "product/packages/osu-skin-core/src",
  "tags": [
    "scope:osu-skin",
    "type:library",
    "runtime:pure"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run build"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run test"
      }
    },
    "package-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run build && bun run package-smoke"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run check"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/osu-skin-core",
        "command": "bun run check"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
