{
  "name": "@tenzyu/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "dependencies": {
    "@base-ui/react": "*",
    "@hookform/resolvers": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "cmdk": "*",
    "date-fns": "*",
    "embla-carousel-react": "*",
    "input-otp": "*",
    "lucide-react": "*",
    "next-themes": "*",
    "radix-ui": "*",
    "react-day-picker": "*",
    "react-hook-form": "*",
    "react-resizable-panels": "*",
    "recharts": "*",
    "sonner": "*",
    "tailwind-merge": "*",
    "vaul": "*",
    "zod": "*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && bun scripts/fix-js-extensions.mjs && bun scripts/create-flat-public-entries.mjs && bun scripts/copy-assets.mjs && bun scripts/prune-private-dist-entries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "typescript": "*"
  }
}
