{
  "name": "@tenzyu/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/workbench.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./workbench.css": "./dist/workbench.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "dependencies": {
    "class-variance-authority": "*",
    "clsx": "*",
    "lucide-react": "*",
    "radix-ui": "*",
    "tailwind-merge": "*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && vite build && bun scripts/build-css.mjs",
    "typecheck": "vite:typecheck",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "typescript": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "postcss": "^8.5.6"
  }
}
