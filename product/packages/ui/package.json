{
  "name": "@tenzyu/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/workbench.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./workbench.css": "./dist/workbench.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "dependencies": {
    "@base-ui/react": "*",
    "@hookform/resolvers": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "cmdk": "*",
    "date-fns": "*",
    "embla-carousel-react": "*",
    "input-otp": "*",
    "lucide-react": "*",
    "next-themes": "*",
    "radix-ui": "*",
    "react-day-picker": "*",
    "react-hook-form": "*",
    "react-resizable-panels": "*",
    "recharts": "*",
    "sonner": "*",
    "tailwind-merge": "*",
    "vaul": "*",
    "zod": "*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && nx vite:build && bun scripts/build-css.mjs",
    "typecheck": "nx vite:typecheck",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "typescript": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^4.2.1",
    "postcss": "^8.5.6"
  }
}
