{
  "name": "ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "product/packages/ui/src",
  "projectType": "library",
  "tags": [
    "type:library",
    "domain:design-system"
  ],
  "// targets": "to see all targets run: nx show project ui --web",
  "targets": {
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "build",
        "test"
      ],
      "cache": false
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "check",
        "storybook:build"
      ],
      "cache": false
    },
    "storybook:build": {
      "command": "bun run build:storybook",
      "options": {
        "cwd": "product/packages/ui"
      },
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/storybook-static"
      ],
      "cache": true
    },
    "serve:storybook": {
      "command": "bun run storybook",
      "options": {
        "cwd": "product/packages/ui"
      },
      "continuous": true,
      "cache": false
    },
    "build": {
      "command": "bun run build",
      "options": {
        "cwd": "product/packages/ui"
      },
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    }
  }
}
