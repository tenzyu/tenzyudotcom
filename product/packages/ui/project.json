{
  "name": "ui",
  "projectType": "library",
  "root": "product/packages/ui",
  "sourceRoot": "product/packages/ui/src",
  "tags": [
    "scope:ui",
    "type:library"
  ],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run clean"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run build"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run test"
      }
    },
    "package-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run build && bun run package-smoke"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "prepack": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run prepack"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run storybook"
      },
      "cache": false
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run build:storybook"
      },
      "outputs": [
        "{projectRoot}/storybook-static"
      ]
    },
    "check-storybook-catalog": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run check:storybook-catalog"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run check"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/packages/ui",
        "command": "bun run check"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
