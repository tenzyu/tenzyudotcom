{
  "name": "skin-workbench",
  "projectType": "application",
  "root": "product/apps/osu-skin-workbench",
  "sourceRoot": "product/apps/osu-skin-workbench/src",
  "tags": [
    "scope:workbench",
    "type:app",
    "runtime:tauri"
  ],
  "implicitDependencies": [
    "ui",
    "osu-skin-core"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run dev"
      },
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "dev-vite": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run dev:vite"
      },
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run build"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target",
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "build-vite": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run build:vite"
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run test"
      }
    },
    "cargo-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run cargo:check"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target"
      ]
    },
    "cargo-clippy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run cargo:clippy"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target"
      ]
    },
    "tauri-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run tauri:build"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target",
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run check"
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run verify && bun run cargo:check && bun run cargo:clippy"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target",
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ]
    }
  }
}
