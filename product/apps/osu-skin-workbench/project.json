{
  "name": "skin-workbench",
  "projectType": "application",
  "root": "product/apps/osu-skin-workbench",
  "sourceRoot": "product/apps/osu-skin-workbench/src",
  "tags": [
    "scope:workbench",
    "type:app",
    "runtime:tauri"
  ],
  "targets": {
    "dev": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "dev-vite": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run dev:vite"
      },
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "outputs": [
        "{projectRoot}/src-tauri/target",
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "check"
      ],
      "cache": false
    },
    "build-vite": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run vite build"
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build",
        "typecheck"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "cargo-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run cargo:check"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target"
      ],
      "cache": false
    },
    "cargo-clippy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run cargo:clippy"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target"
      ],
      "cache": false
    },
    "tauri-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/osu-skin-workbench",
        "command": "bun run tauri:build"
      },
      "outputs": [
        "{projectRoot}/src-tauri/target",
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "test",
        "build-vite"
      ],
      "cache": false
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "check",
        "cargo-check",
        "cargo-clippy",
        "cargo-test"
      ],
      "cache": false
    },
    "cargo-test": {
      "command": "cargo test --locked --manifest-path product/apps/osu-skin-workbench/src-tauri/Cargo.toml",
      "cache": false
    }
  }
}
