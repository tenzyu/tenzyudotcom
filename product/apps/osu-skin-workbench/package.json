{
  "name": "@tenzyu/osu-skin-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite --host 127.0.0.1 --port 1420",
    "build": "tauri build",
    "build:vite": "tsc --noEmit && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build:vite",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "tauri:build": "tauri build",
    "verify": "bun run check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tenzyu/osu-skin-core": "workspace:*",
    "@tenzyu/ui": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.11",
    "typescript": "^5.9.3"
  }
}
