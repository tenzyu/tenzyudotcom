{
  "name": "atelier",
  "projectType": "application",
  "root": "product/apps/atelier",
  "sourceRoot": "product/apps/atelier/src",
  "tags": [
    "scope:atelier",
    "type:app",
    "runtime:bun",
    "interface:cli"
  ],
  "implicitDependencies": [],
  "targets": {
    "doctor": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run doctor -- --project-root ../../.."
      },
      "cache": false
    },
    "index": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run index -- --project-root ../../.."
      },
      "outputs": [
        "{workspaceRoot}/.harness/generated"
      ],
      "cache": false
    },
    "index-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run index -- --project-root ../../.. --check"
      },
      "cache": false
    },
    "context-preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run ./src/cli.ts context preview --project-root ../../.."
      },
      "cache": false
    },
    "context-expand": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run ./src/cli.ts context expand --project-root ../../.."
      },
      "cache": false
    },
    "run-init": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run ./src/cli.ts run init --project-root ../../.."
      },
      "cache": false
    },
    "run-close": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run ./src/cli.ts run close --project-root ../../.."
      },
      "cache": false
    },
    "knowledge": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run ./src/cli.ts knowledge --project-root ../../.."
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run build"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run test"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run check"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/atelier",
        "command": "bun run check && bun run doctor -- --project-root ../../.. --json"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
