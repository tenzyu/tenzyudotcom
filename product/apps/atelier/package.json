{
  "name": "@tenzyu/atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "atelier": "./src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir dist --target bun && bun x tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "doctor": "bun run ./src/cli.ts doctor",
    "index": "bun run ./src/cli.ts index",
    "context": "bun run ./src/cli.ts context",
    "run:init": "bun run ./src/cli.ts run init",
    "run:close": "bun run ./src/cli.ts run close",
    "knowledge": "bun run ./src/cli.ts knowledge",
    "id": "bun run ./src/cli.ts id",
    "generate": "bun run ./src/cli.ts generate --write"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
