{
  "extends": "../../../tsconfig.next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": [
      "bun-types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".intlayer/**/*.ts",
    "intlayer.config.ts",
    "next.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
