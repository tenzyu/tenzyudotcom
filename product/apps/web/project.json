{
  "name": "web",
  "projectType": "application",
  "root": "product/apps/web",
  "sourceRoot": "product/apps/web/src",
  "tags": [
    "scope:web",
    "type:app"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run dev"
      },
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "dev-overlay": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run dev:overlay"
      },
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run clean"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run build"
      },
      "outputs": [
        "{projectRoot}/.next"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "build-prod": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run build:prod"
      },
      "outputs": [
        "{projectRoot}/.next"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run start"
      },
      "cache": false
    },
    "start-intlayer": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run start:intlayer"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run lint"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/repo-ops/scripts/biome"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run format"
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run typecheck"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run test"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        "typecheck",
        "test"
      ],
      "cache": false
    },
    "publication-acceptance": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/repo-ops/renewal/**/*"
      ],
      "options": {
        "command": "node repo-ops/renewal/run-publication-acceptance.mjs"
      }
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "check",
        "build"
      ],
      "cache": false
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "product/apps/web",
        "command": "bun run analyze"
      },
      "cache": false
    }
  }
}
