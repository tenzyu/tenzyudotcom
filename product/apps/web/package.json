{
  "name": "@tenzyu/web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:overlay": "ENABLE_REACT_GRAB_OVERLAY=1 bunx @react-grab/codex@0.1.29 && ENABLE_REACT_GRAB_OVERLAY=1 intlayer watch --with 'next dev'",
    "clean": "rimraf .next",
    "build": "next build",
    "build:prod": "bun run clean && NODE_ENV=production bun --env-file .env.prod next build",
    "start": "bun run clean && bun run build && next start",
    "start:intlayer": "intlayer-editor start",
    "lint": "bun run lint:biome && bun run lint:custom",
    "lint:biome": "../../../repo-ops/scripts/biome lint .",
    "lint:custom": "tenzyu-linter --project-root .",
    "lint:fix": "../../../repo-ops/scripts/biome lint --fix .",
    "format": "../../../repo-ops/scripts/biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:quick": "bun run lint && bun run typecheck && bun run test",
    "verify": "bun run verify:quick && bun run build",
    "analyze": "next experimental-analyze"
  },
  "dependencies": {
    "@tenzyu/ui": "workspace:*",
    "@vercel/analytics": "catalog:",
    "@vercel/speed-insights": "catalog:",
    "embla-carousel-react": "catalog:",
    "gray-matter": "catalog:",
    "intlayer": "catalog:",
    "intlayer-editor": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intlayer": "catalog:",
    "next-themes": "catalog:",
    "osu-api-v2-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-tweet": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tenzyu/linter": "workspace:*",
    "@mdx-js/loader": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@mdx-js/react": "catalog:",
    "@next/mdx": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@types/bun": "catalog:",
    "@types/mdx": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "rehype-autolink-headings": "catalog:",
    "rehype-pretty-code": "catalog:",
    "rehype-slug": "catalog:",
    "remark-gfm": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
