{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{ts,tsx,js,jsx}",
      "test/**/*.{ts,tsx,js,jsx}",
      "!**/*.min.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "indentWidth": 2,
      "indentStyle": "space",
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noProcessEnv": "error"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noImportCycles": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/config/env.infra.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/features/**/*.{ts,tsx,js,jsx}",
        "src/components/**/*.{ts,tsx,js,jsx}",
        "src/lib/**/*.{ts,tsx,js,jsx}",
        "src/platform/**/*.{ts,tsx,js,jsx}",
        "src/config/**/*.{ts,tsx,js,jsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/composition/**"
                    ],
                    "message": "Routing/composition depends on product features and shared leaves, not the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "recommended": true
      }
    }
  }
}
