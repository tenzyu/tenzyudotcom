{
  "name": "tenzyudotcom",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "product/apps/*",
    "product/packages/*"
  ],
  "scripts": {
    "nx": "nx",
    "dev": "nx run web:dev",
    "build": "nx run-many -t build",
    "check": "nx run-many -t check",
    "lint": "nx run-many -t lint",
    "lint:workspace": "nx run linter:lint-rules",
    "format": "nx run-many -t format",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "verify": "nx run-many -t verify",
    "verify:workspace": "bun run policy:deps && bun run lint:workspace",
    "affected:build": "nx affected -t build",
    "affected:check": "nx affected -t check",
    "graph": "nx graph",
    "dev:web": "nx run web:dev",
    "dev:web:overlay": "nx run web:dev-overlay",
    "build:web": "nx run web:build",
    "build:web:prod": "nx run web:build-prod",
    "start:web": "nx run web:start",
    "start:web:intlayer": "nx run web:start-intlayer",
    "analyze:web": "nx run web:analyze",
    "dev:skin-workbench": "nx run skin-workbench:dev",
    "dev:skin-workbench:vite": "nx run skin-workbench:dev-vite",
    "build:skin-workbench": "nx run skin-workbench:build",
    "build:skin-workbench:vite": "nx run skin-workbench:build-vite",
    "build:ui": "nx run ui:build",
    "typecheck:ui": "nx run ui:typecheck",
    "prepack:ui": "nx run ui:prepack",
    "lint:rules": "nx run linter:lint-rules",
    "docs-rename": "bun repo-ops/scripts/docs-rename.ts",
    "build:docs-map": "bun repo-ops/scripts/compile-agents-md.ts",
    "test:scripts": "bun test repo-ops/scripts/compile-agents-md.test.ts repo-ops/scripts/docs-rename.test.ts repo-ops/scripts/migrate-notes-threading.test.ts",
    "policy:deps": "bun repo-ops/scripts/check-dependency-policy.ts"
  },
  "devDependencies": {
    "nx": "22.6.5",
    "@nx/js": "22.6.5"
  }
}
