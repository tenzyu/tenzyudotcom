{
  "name": "tenzyudotcom",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter @tenzyu/web dev",
    "dev:web:overlay": "bun run --filter @tenzyu/web dev:overlay",

    "clean:web": "bun run --filter @tenzyu/web clean",

    "build:web": "bun run --filter @tenzyu/web build",
    "build:web:prod": "bun run --filter @tenzyu/web build:prod",

    "start:web": "bun run --filter @tenzyu/web start",
    "start:web:intlayer": "bun run --filter @tenzyu/web start:intlayer",

    "lint:web": "bun run --filter @tenzyu/web lint",

    "format:web": "bun run --filter @tenzyu/web format",

    "typecheck": "bun run typecheck:web",
    "typecheck:web": "bun run --filter @tenzyu/web typecheck",

    "test": "bun run test:web && bun run test:linter && bun run test:scripts",
    "test:web": "bun run --filter @tenzyu/web test",
    "test:linter": "bun run --filter @tenzyu/linter test",
    "test:scripts": "bun test scripts/compile-agents-md.test.ts scripts/docs-rename.test.ts scripts/migrate-notes-threading.test.ts",

    "verify:quick": "bun run lint && bun run lint:rules && bun run typecheck && bun run test",
    "verify": "bun run verify:quick && bun run build",

    "dev:skin-workbench": "bun run --filter @tenzyu/osu-skin-workbench dev",
    "build:skin-workbench": "bun run --filter @tenzyu/osu-skin-workbench build",
    "test:skin-workbench": "bun run --filter @tenzyu/osu-skin-workbench test",
    "check:skin-workbench": "bun run --filter @tenzyu/osu-skin-workbench check",
    "dev:skin-workbench:tauri": "bun run --filter @tenzyu/osu-skin-workbench dev:tauri",
    "build:skin-workbench:tauri": "bun run --filter @tenzyu/osu-skin-workbench build:tauri",

    "lint:fix": "bun run --filter @tenzyu/web lint:fix",
    "lint:rules": "bun run --filter @tenzyu/linter lint:rules ../..",

    "verify:all": "bun run verify && bun run check:skin-workbench",

    "migrate:notes-threading": "bun scripts/migrate-notes-threading.ts",
    "docs-rename": "bun scripts/docs-rename.ts",
    "build:docs-map": "bun scripts/compile-agents-md.ts",

    "analyze": "bun run --filter @tenzyu/web analyze"
  },
  "devDependencies": {
