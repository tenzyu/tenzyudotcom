{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atelier.fixture/v1",
  "type": "object",
  "required": ["schema", "fixture_id", "gate_id", "status", "provenance", "provenance_kind"],
  "properties": {
    "schema": { "const": "atelier.fixture/v1" },
    "fixture_id": { "type": "string" },
    "gate_id": { "type": "string" },
    "status": { "enum": ["executable", "pending_command_implementation", "oracle_gap"] },
    "provenance": { "type": "string" },
    "provenance_kind": { "enum": ["deterministic_fact", "llm_extracted", "legacy_promoted", "manual_control_record"] }
  }
}
