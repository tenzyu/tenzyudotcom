{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atelier.packet-template/v1",
  "type": "object",
  "required": ["schema", "template_id", "title", "dag_node_id", "source_refs", "assertions", "allowed_files", "forbidden_files", "required_gates", "required_fixtures", "validation_profile", "evidence_expectations", "subagent_role", "completion_criteria", "provenance_kind", "provenance_ref"],
  "properties": {
    "schema": { "const": "atelier.packet-template/v1" },
    "template_id": { "type": "string" },
    "title": { "type": "string" },
    "dag_node_id": { "type": "string" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "assertions": { "type": "array", "items": { "type": "string" } },
    "allowed_files": { "type": "array", "items": { "type": "string" } },
    "forbidden_files": { "type": "array", "items": { "type": "string" } },
    "required_gates": { "type": "array", "items": { "type": "string" } },
    "required_fixtures": { "type": "array", "items": { "type": "string" } },
    "no_fixture_reason": { "type": "string" },
    "validation_profile": { "type": "string" },
    "evidence_expectations": { "type": "array", "items": { "type": "string" } },
    "subagent_role": { "type": "string" },
    "completion_criteria": { "type": "array", "items": { "type": "string" } },
    "provenance_kind": { "enum": ["deterministic_fact", "llm_extracted", "legacy_promoted", "manual_control_record"] },
    "provenance_ref": { "type": "string" }
  }
}
