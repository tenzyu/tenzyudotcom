{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atelier": {
      "type": "local",
      "command": [
        "bun",
        "product/apps/atelier/src/cli.ts",
        "mcp",
        "--project-root",
        "."
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context", "ide-assistant"],
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md", ".opencode/agents/*.md"],
  "lsp": true
}
