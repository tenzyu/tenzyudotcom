{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",

    "bash": {
      "*": "ask",

      "cargo run -p *": "allow",

      "sleep *": "allow",
      "hyprctl *": "allow",
      "kill *": "allow",
      "true *": "allow",
      "wait *": "allow",

      "pwd": "allow",
      "ls*": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "sed -n *": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git add *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",

      "bun run *": "allow",
      "bun test *": "allow",
      "bunx tsc *": "allow",
      "bunx vite *": "allow",
      "bunx nx *": "allow",
      "bun install*": "allow",
      "bun add *": "ask",
      "bun remove *": "ask",

      "nix flake check *": "allow",
      "nix develop *": "allow",
      "nh os build *": "allow",

      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "chmod *": "ask",

      "sudo *": "deny",
      "chown *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask"
    },

    "external_directory": "ask"
  }
}
