{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context", "ide-assistant"],
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md"],
  "lsp": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "target/**",
      "*.zip",
      "*.log"
    ]
  }
}
