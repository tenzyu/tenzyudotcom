{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atelier": {
      "type": "local",
      "command": [
        "bun",
        "product/apps/atelier/src/cli.ts",
        "mcp",
        "--project-root",
        "."
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context", "ide-assistant"],
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md"],
  "lsp": true,
  "plugin": [
    [
      "opencode-goal-plugin",
      {
        "maxTurns": 40,
        "maxDurationMs": 21600000,
        "maxTokens": 4000000,
        "minDelayMs": 1500,
        "maxRecentMessages": 200,
        "noProgressTokenThreshold": 50,
        "noProgressTurnsBeforePause": 5,
        "budgetWrapupRatio": 0.9,
        "maxPromptFailures": 10,
        "persistState": true,
        "stateFilePath": ".opencode/opencode-goal-plugin/state.json",
        "resultRetentionMs": 604800000,
        "maxStoredResults": 200
      }
    ]
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "harness/knowledge/implementation-control/atelier/state/legacy/**",
      "harness/knowledge/implementation-control/atelier/archive/**"
    ]
  },
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete. Provided by opencode-goal-plugin.",
      "template": "$ARGUMENTS",
      "agent": "atelier-coordinator"
    }
  }
}
