{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "product/apps",
    "libsDir": "product/packages"
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/README.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/flake.lock",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.bun.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.next.json",
      "{workspaceRoot}/tsconfig.react-lib.json",
      "{workspaceRoot}/tsconfig.vite.json",
      "{workspaceRoot}/product/apps/osu-skin-workbench/src-tauri/Cargo.lock"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "build-vite": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "check": {
      "dependsOn": [
        "typecheck",
        "test"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "verify": {
      "dependsOn": [
        "check",
        "build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    }
  ],
  "analytics": false,
  "tui": {
    "enabled": false,
    "autoExit": true
  }
}
